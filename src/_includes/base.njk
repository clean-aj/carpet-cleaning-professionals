<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set fullTitle = metaTitle | seoTitle(title, site.name) %}
  {%- set metaDescription = description or site.defaultDescription %}
  {%- set canonical = page.url | absoluteUrl %}
  <title>{{ fullTitle }}</title>
  <meta name="description" content="{{ metaDescription }}">
  <link rel="canonical" href="{{ canonical }}">
  {%- if noindex %}<meta name="robots" content="noindex">{% endif %}
  <meta property="og:type" content="{{ 'article' if pageType == 'post' else 'website' }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="en_GB">
  <meta property="og:title" content="{{ fullTitle }}">
  <meta property="og:description" content="{{ metaDescription }}">
  <meta property="og:url" content="{{ canonical }}">
  {%- set ogImage = image or site.logo %}
  {%- if ogImage %}
  <meta property="og:image" content="{{ ogImage | absoluteUrl }}">
  {%- if image %}
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ imageAlt }}">
  {%- endif %}
  <meta name="twitter:card" content="summary_large_image">
  {%- else %}
  <meta name="twitter:card" content="summary">
  {%- endif %}
  {%- if pageType == "post" %}
  <meta property="article:published_time" content="{{ date | isoDate }}">
  {%- endif %}
  <link rel="icon" href="/favicon.ico" sizes="48x48">
  <link rel="icon" href="/assets/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="icon" href="/assets/favicon-96.png" sizes="96x96" type="image/png">
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
  <link rel="stylesheet" href="/assets/styles.css?v={{ build.cssVersion }}">
  {% schema { page: page, title: title, description: metaDescription, date: date, pageType: pageType, image: image, imageAlt: imageAlt, faqs: faqs, town: town, county: county, wikipedia: wikipedia, locations: collections.locations } %}
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  {% include "partials/header.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  {% include "partials/mobile-bar.njk" %}
</body>
</html>
