---
layout: base.njk
---
{%- from "macros.njk" import townLinks %}
{% include "partials/page-hero.njk" %}
<section class="section">
  <div class="container with-sidebar">
    <article class="prose">
      {%- if image %}<img class="hero-image" src="{{ image }}" alt="{{ imageAlt }}" loading="eager" fetchpriority="high">{% endif %}
      {{ content | withCtas(site.phone) | safe }}

      {% include "partials/slider.njk" %}

      {%- if faqs %}
      <h2>{{ title }}: Frequently Asked Questions</h2>
      <div class="faqs">
        {%- for f in faqs %}
        <details>
          <summary>{{ f.question }}</summary>
          <p>{{ f.answer }}</p>
        </details>
        {%- endfor %}
      </div>
      {%- endif %}

      {%- set nearby = collections.locations | inRegion(region, page.url) %}
      {%- if nearby.length %}
      <h2>We Also Cover These Areas in {{ region }}</h2>
      {{ townLinks(nearby, 8, "More locations in " ~ region) }}
      {%- endif %}
    </article>
    <aside class="sidebar">
      <div class="card quote-card">
        {%- if site.technicianPhoto %}<img class="quote-photo" src="{{ site.technicianPhoto }}" alt="{{ site.technicianPhotoAlt }}" sizes="320px">{% endif %}
        <h2>Free Quote in {{ town }}</h2>
        <p>Tell us what needs cleaning and we'll give you a clear, fixed price.</p>
        {%- if site.phone %}<p><a class="btn btn-block" href="{{ site.phone | telLink }}">Call {{ site.phone }}</a></p>{% endif %}
        <p><a class="btn btn-outline btn-block" href="/contact/">Send an enquiry</a></p>
        {%- if site.openingHoursText %}<p class="meta">{{ site.openingHoursText }}</p>{% endif %}
      </div>
      <div class="card">
        <h2>Our Services</h2>
        <ul class="plain">
          {%- for s in collections.services %}<li><a href="{{ s.url }}">{{ s.data.title }}</a></li>{% endfor %}
        </ul>
      </div>
      {%- if site.reviews and site.reviews.url %}
      <a class="card review-badge" href="{{ site.reviews.url }}" target="_blank" rel="noopener">
        <span class="stars" aria-hidden="true">★★★★★</span>
        <strong>{{ site.reviews.summary }}</strong>
        <span>Read what our customers say →</span>
      </a>
      {%- endif %}
    </aside>
  </div>
</section>
{% include "partials/cta.njk" %}
