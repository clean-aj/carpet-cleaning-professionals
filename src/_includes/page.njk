---
layout: base.njk
---
{%- set slug = page.fileSlug %}
{%- if slug == "home" %}
<section class="hero">
  <div class="container hero-inner">
    <h1>{{ heading or title }}</h1>
    {%- if intro %}<p class="lead">{{ intro }}</p>{% endif %}
    <div class="hero-actions">
      <a class="btn" href="/contact/">Get a free quote</a>
      {%- if site.phone %}<a class="btn btn-outline" href="{{ site.phone | telLink }}">Call {{ site.phone }}</a>{% endif %}
    </div>
    {%- if highlights %}
    <ul class="highlights">
      {%- for h in highlights %}<li>{{ h }}</li>{% endfor %}
    </ul>
    {%- endif %}
  </div>
</section>

<section class="section">
  <div class="container prose">{{ content | safe }}</div>
</section>

<section class="section section-alt">
  <div class="container">
    <h2 class="section-title">Our Services</h2>
    {% include "partials/service-grid.njk" %}
  </div>
</section>

{%- if site.teamPhoto %}
<section class="section team-section">
  <div class="container team-grid">
    <img class="team-photo" src="{{ site.teamPhoto }}" alt="{{ site.teamPhotoAlt }}" sizes="(min-width: 900px) 620px, 100vw">
    <div>
      <h2>Meet the Team Who'll Look After Your Home</h2>
      <p>You want people you can trust in your home. Our technicians are friendly, uniformed and fully equipped, and they treat your home with the same care as their own.</p>
      <p>They arrive on time, protect your floors and furniture, and leave your rooms clean, fresh and tidy.</p>
      <p><a class="btn" href="/about/">About us</a> <a class="btn btn-outline" href="/contact/">Get a free quote</a></p>
    </div>
  </div>
</section>
{%- endif %}

{%- if gallery %}
<section class="section section-alt">
  <div class="container">
    <h2 class="section-title">See the Difference</h2>
    <ul class="gallery">
      {%- for g in gallery %}
      <li>
        <figure>
          <img src="{{ g.image }}" alt="{{ g.alt }}" sizes="(min-width: 900px) 360px, 100vw">
        </figure>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
{%- endif %}

{%- if features %}
<section class="section">
  <div class="container">
    <h2 class="section-title">{{ featuresHeading or "Why Choose Us" }}</h2>
    <ul class="feature-grid">
      {%- for f in features %}
      <li><h3>{{ f.title }}</h3><p>{{ f.text }}</p></li>
      {%- endfor %}
    </ul>
  </div>
</section>
{%- endif %}

{%- if collections.locations.length %}
<section class="section">
  <div class="container">
    <h2 class="section-title">Areas We Cover</h2>
    <ul class="region-pills">
      {%- for g in collections.locations | groupByRegion %}<li><a href="/areas/#{{ g.slug }}">{{ g.region }}</a></li>{% endfor %}
    </ul>
    <p class="center"><a href="/areas/">See all {{ collections.locations.length }} towns and cities we cover →</a></p>
  </div>
</section>
{%- endif %}

{%- if collections.posts.length %}
<section class="section section-alt">
  <div class="container">
    <h2 class="section-title">Cleaning Tips &amp; Advice</h2>
    {%- set postLimit = 3 %}
    {% include "partials/post-list.njk" %}
    <p><a href="/blog/">Read all articles →</a></p>
  </div>
</section>
{%- endif %}
{% include "partials/cta.njk" %}

{%- else %}
{% include "partials/page-hero.njk" %}
<section class="section">
  <div class="container prose">
    {%- if image %}<img class="hero-image" src="{{ image }}" alt="{{ imageAlt }}" loading="eager" fetchpriority="high" sizes="(min-width: 800px) 760px, 100vw">{% endif %}
    {{ content | safe }}
  </div>
  {%- if slug == "services" %}<div class="container">{% include "partials/service-grid.njk" %}</div>{% endif %}
  {%- if slug == "areas" %}<div class="container">{% include "partials/areas-list.njk" %}</div>{% endif %}
  {%- if slug == "contact" %}<div class="container">{% include "partials/contact.njk" %}</div>{% endif %}
</section>
{%- if slug != "contact" %}{% include "partials/cta.njk" %}{% endif %}
{%- endif %}
