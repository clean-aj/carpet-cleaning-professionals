{%- from "macros.njk" import townLinks %}
{%- set groups = collections.locations | groupByRegion %}
<ul class="area-stats">
  <li><strong>{{ collections.locations.length }}</strong> towns &amp; cities</li>
  <li><strong>{{ groups.length }}</strong> regions</li>
  <li><strong>7 days</strong> a week, 8am to 8pm</li>
</ul>

<div class="area-search">
  <label for="town-search">Find Your Town</label>
  <input id="town-search" type="search" placeholder="Start typing, e.g. Reading" autocomplete="off">
  <p id="town-search-status" class="meta" aria-live="polite"></p>
</div>

<section class="regions">
  <div class="region-grid">
    {%- for g in groups %}
    <section id="{{ g.slug }}" class="region-card">
      <header>
        <h2>Carpet Cleaning {{ g.region }}</h2>
        <span class="pill">{{ g.items.length }} location{% if g.items.length != 1 %}s{% endif %}</span>
      </header>
      {{ townLinks(g.items, 6, "More locations") }}
    </section>
    {%- endfor %}
  </div>
  <p id="town-search-empty" class="no-results" hidden>We couldn't find that town in our list, but we may still cover it. Call <a href="{{ site.phone | telLink }}">{{ site.phone }}</a> and we'll check for you.</p>
</section>

<section class="area-help card">
  <h2>Can't See Your Town?</h2>
  <p>We're adding new areas all the time. Call us and we'll tell you straight away whether we can help.</p>
  <p><a class="btn" href="{{ site.phone | telLink }}">Call {{ site.phone }}</a> <a class="btn btn-outline" href="/contact/">Send an enquiry</a></p>
</section>

<script>
(() => {
  const input = document.getElementById("town-search");
  const status = document.getElementById("town-search-status");
  const empty = document.getElementById("town-search-empty");
  const cards = [...document.querySelectorAll(".region-card")];
  const grid = document.querySelector(".region-grid");
  input.addEventListener("input", () => {
    const q = input.value.trim().toLowerCase();
    let total = 0;
    for (const card of cards) {
      let hits = 0;
      for (const li of card.querySelectorAll(".area-links li")) {
        const match = !q || li.textContent.toLowerCase().includes(q);
        li.hidden = !match;
        if (match) hits++;
      }
      const more = card.querySelector("details");
      if (more) more.open = !!q && [...more.querySelectorAll("li")].some((li) => !li.hidden);
      card.hidden = !!q && hits === 0;
      total += q ? hits : 0;
    }
    grid.classList.toggle("searching", !!q);
    empty.hidden = !q || total > 0;
    status.textContent = q ? (total ? total + " matching location" + (total === 1 ? "" : "s") : "") : "";
  });
})();
</script>
