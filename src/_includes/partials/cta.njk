<section class="cta">
  <div class="container cta-inner">
    <div>
      <h2>Ready for Fresh, Clean Carpets?</h2>
      <p>Get a free, no-obligation quote today.</p>
    </div>
    <div class="cta-actions">
      {%- if site.phone %}<a class="btn btn-light" href="{{ site.phone | telLink }}">Call {{ site.phone }}</a>{% endif %}
      <a class="btn btn-outline-light" href="/contact/">Request a quote</a>
    </div>
  </div>
</section>
