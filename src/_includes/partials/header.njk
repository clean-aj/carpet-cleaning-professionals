<header class="site-header">
  <div class="container header-inner">
    <a class="logo" href="/">
      {%- if site.logo %}<img src="{{ site.logo }}" alt="{{ site.name }} logo" width="340" height="44" eleventy:ignore>{% else %}<span class="logo-mark" aria-hidden="true">✦</span> {{ site.name }}{% endif -%}
    </a>
    <button class="menu-toggle" type="button" aria-controls="site-nav" aria-expanded="false">
      <span class="menu-icon" aria-hidden="true"></span><span class="menu-label">Menu</span>
    </button>
    <nav id="site-nav" aria-label="Main">
      <ul class="nav">
        {%- for item in site.nav %}
        {%- set sub = collections.services if item.url == "/services/" else ((collections.locations | featured) if item.url == "/areas/" else []) %}
        {%- if sub.length %}
        <li class="has-sub">
          <a href="{{ item.url }}"{% if item.url | isCurrent(page.url, pageType) %} aria-current="page"{% endif %}>{{ item.label }}</a>
          <button class="sub-toggle" type="button" aria-expanded="false" aria-label="Show {{ item.label | lower }} menu"><span aria-hidden="true">▾</span></button>
          <ul class="sub-menu">
            {%- for s in sub %}<li><a href="{{ s.url }}">{{ s.data.town or s.data.title }}</a></li>{% endfor %}
            <li class="sub-all"><a href="{{ item.url }}">{{ "All services" if item.url == "/services/" else "All areas we cover" }} →</a></li>
          </ul>
        </li>
        {%- else %}
        <li><a href="{{ item.url }}"{% if item.url | isCurrent(page.url, pageType) %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endif %}
        {%- endfor %}
      </ul>
    </nav>
    {%- if site.phone %}
    <a class="btn btn-small header-phone" href="{{ site.phone | telLink }}">Call {{ site.phone }}</a>
    {%- endif %}
  </div>
  <script>
    document.documentElement.classList.add("js");
    (() => {
      const btn = document.querySelector(".menu-toggle"), nav = document.getElementById("site-nav");
      btn.addEventListener("click", () => {
        const open = nav.classList.toggle("open");
        btn.setAttribute("aria-expanded", open);
      });
      const subs = [...document.querySelectorAll(".has-sub")];
      const closeAll = (except) => subs.forEach((li) => { if (li !== except) { li.classList.remove("open"); li.querySelector(".sub-toggle").setAttribute("aria-expanded", "false"); } });
      subs.forEach((li) => {
        const t = li.querySelector(".sub-toggle");
        t.addEventListener("click", (e) => {
          e.stopPropagation();
          const open = !li.classList.contains("open");
          closeAll(li); li.classList.toggle("open", open); t.setAttribute("aria-expanded", open);
        });
      });
      document.addEventListener("click", (e) => { if (!e.target.closest(".has-sub")) closeAll(); });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeAll(); });
    })();
  </script>
</header>
