{%- set r = site.reviews %}
{%- if r and r.url %}
<section class="section reviews">
  <div class="container">
    <div class="reviews-head">
      <div>
        <h2>{{ r.heading or "What Our Customers Say" }}</h2>
        <p class="reviews-score"><span class="stars" aria-hidden="true">★★★★★</span> <span>{{ r.summary }}</span></p>
        {%- if r.platforms.length %}
        <ul class="review-platforms" aria-label="Where to find our reviews">
          {%- for pl in r.platforms %}<li>{% if pl.url %}<a href="{{ pl.url }}" target="_blank" rel="noopener">{{ pl.name }}</a>{% else %}<span>{{ pl.name }}</span>{% endif %}</li>{% endfor %}
        </ul>
        {%- endif %}
      </div>
      <div class="reviews-actions">
        <a class="btn" href="{{ r.url }}" target="_blank" rel="noopener">Read our reviews</a>
        {%- if r.writeUrl %}<a class="btn btn-outline" href="{{ r.writeUrl }}" target="_blank" rel="noopener">Review us on Google</a>{% endif %}
      </div>
    </div>
    {%- if r.items.length %}
    <ul class="review-grid">
      {%- for item in r.items %}
      <li class="review-card">
        <p class="stars" aria-label="{{ item.rating or 5 }} out of 5 stars">{% for n in range(0, item.rating or 5) %}★{% endfor %}</p>
        <blockquote>{{ item.text }}</blockquote>
        <p class="review-meta"><strong>{{ item.name }}</strong>{% if item.town %}, {{ item.town }}{% endif %}{% if item.date %} · {{ item.date }}{% endif %}{% if item.source %} · {{ item.source }} review{% endif %}</p>
      </li>
      {%- endfor %}
    </ul>
    {%- endif %}
  </div>
</section>
{%- endif %}
