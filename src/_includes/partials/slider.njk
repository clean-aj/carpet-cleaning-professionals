{%- if slider.photos.length %}
<section class="slider" aria-roledescription="carousel" aria-label="{{ slider.heading or 'Photos of Our Work' }}">
  <div class="slider-head">
    <h2>{{ slider.heading or "See Our Work" }}</h2>
    <div class="slider-controls">
      <button type="button" class="slider-btn" data-dir="-1" aria-label="Previous photos">&#8249;</button>
      <button type="button" class="slider-btn" data-dir="1" aria-label="Next photos">&#8250;</button>
    </div>
  </div>
  <ul class="slider-track" tabindex="0">
    {%- for p in slider.photos %}
    <li class="slide" aria-roledescription="slide" aria-label="{{ loop.index }} of {{ slider.photos.length }}">
      <figure>
        <img src="{{ p.image }}" alt="{{ p.alt }}" sizes="(min-width: 900px) 260px, 75vw">
      </figure>
    </li>
    {%- endfor %}
  </ul>
</section>
<script>
document.querySelectorAll(".slider").forEach((s) => {
  const track = s.querySelector(".slider-track");
  s.querySelectorAll(".slider-btn").forEach((b) => b.addEventListener("click", () => {
    track.scrollBy({ left: Number(b.dataset.dir) * track.clientWidth * 0.9, behavior: "smooth" });
  }));
});
</script>
{%- endif %}
