---
pagination:
  data: collections.posts
  size: 12
  alias: posts
permalink: "/blog/{% if pagination.pageNumber > 0 %}page/{{ pagination.pageNumber + 1 }}/{% endif %}"
layout: base.njk
pageType: page
title: Carpet Cleaning Tips & Advice
intro: Practical advice for keeping your carpets, rugs and upholstery looking their best.
eleventyComputed:
  metaTitle: "Carpet Cleaning Blog{% if pagination.pageNumber > 0 %} – Page {{ pagination.pageNumber + 1 }}{% endif %} | Carpet Cleaning Professionals"
  heading: "Carpet Cleaning Tips & Advice{% if pagination.pageNumber > 0 %} – Page {{ pagination.pageNumber + 1 }}{% endif %}"
  description: "{% if pagination.pageNumber > 0 %}Page {{ pagination.pageNumber + 1 }} of our carpet care articles: {% endif %}Practical advice on carpet care, stain removal and keeping your carpets, rugs and upholstery looking their best."
---
{% include "partials/page-hero.njk" %}
<section class="section">
  <div class="container">
    {%- set postItems = posts %}
    {%- set cardTag = "h2" %}
    {% include "partials/post-list.njk" %}

    {%- if pagination.pages.length > 1 %}
    <nav class="pagination" aria-label="Blog pages">
      {%- if pagination.href.previous %}<a class="btn btn-outline btn-small" href="{{ pagination.href.previous }}" rel="prev">&larr; Newer</a>{% endif %}
      <ol>
        {%- for href in pagination.hrefs %}
        <li><a href="{{ href }}"{% if page.url == href %} aria-current="page"{% endif %}>{{ loop.index }}</a></li>
        {%- endfor %}
      </ol>
      {%- if pagination.href.next %}<a class="btn btn-outline btn-small" href="{{ pagination.href.next }}" rel="next">Older &rarr;</a>{% endif %}
    </nav>
    {%- endif %}
  </div>
</section>
{% include "partials/cta.njk" %}
