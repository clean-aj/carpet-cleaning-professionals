---
pagination:
  data: redirects
  size: 1
  alias: r
permalink: "{{ r.from }}"
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <title>Moved | {{ site.name }}</title>
  <link rel="canonical" href="{{ r.to | absoluteUrl }}">
  <meta name="robots" content="noindex">
  <meta http-equiv="refresh" content="0; url={{ r.to | absoluteUrl }}">
</head>
<body>
  <p>This page has moved to <a href="{{ r.to }}">{{ r.to }}</a>.</p>
</body>
</html>
